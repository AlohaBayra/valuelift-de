---
// ST24 / WP-05 — KI-Mehrwert-Beweis-Raster: „Ein Einzelner führt mit KI eine ganze Firma."
// GEO-PFLICHT: Alle 6 Kacheln rendern fest im statischen HTML (kein JS-Nachladen), damit
// LLM-/Such-Crawler sie sehen. Struktur je Kachel: Vorteil (Kundennutzen, orange) →
// Domänen-Überschrift → 2–3 konkrete Beispiele als kompakte Liste.
// Zahlenfrei (kein Preis/Prozent) — Entscheidung Marcus 2026-06-19.

// 6 Domänen-Kacheln (2×3): benefit = Vorteil-Zeile, title = Kategorie, examples = Beispiele.
const domains = [
  {
    benefit: "Du bleibst sichtbar und im Kopf deiner nächsten Auftraggeber, während du gerade lieferst.",
    title: "Content & Marketing",
    examples: ["LinkedIn-Content-System", "Reel- & Shorts-Skripte", "Wettbewerbs- & Reel-Analyse"],
  },
  {
    benefit: "Du bekommst Werkzeuge, die genau zu deinen individuellen Bedürfnissen passen, statt teurer Abo-Tools.",
    title: "Software ohne Dev-Team",
    examples: ["komplette Web-App (live)", "native Mac-App", "interaktive Rechner & Lead-Tools"],
  },
  {
    benefit: "Du entscheidest aus Daten statt Bauchgefühl und gehst das richtige Thema zuerst an.",
    title: "Strategie & Analyse",
    examples: ["Marktrecherche & Wettbewerb", "Hebel-Analyse", "Positionierung & Zielkunden-Avatar"],
  },
  {
    benefit: "Dein Angebot und dein Auftritt überzeugen schon vor dem Gespräch, damit aus Anfragen Aufträge werden.",
    title: "Verkauf & Conversion",
    examples: ["Sales-Audit (Verkaufspsychologie)", "Website-Audit (CRO/SEO)", "UX-Audit aus Nutzersicht"],
  },
  {
    benefit: "Du bleibst vertraulich und rechtssicher, damit du beim Auftraggeber geschützt bleibst.",
    title: "Wissen & Compliance",
    examples: ["Kurs- & Curriculum-Design", "AVV- & Datenschutz-Entwürfe", "SOPs & Prompt-Bibliotheken"],
  },
  {
    benefit: "Du hast ein ganzes KI-Team, das im Hintergrund arbeitet, während du nur entscheidest.",
    title: "Betrieb & Orchestrierung",
    examples: ["Team aus 12+ KI-Agenten", "KI-Stabschef priorisiert täglich", "persistentes Gedächtnis (kein Neustart bei null)"],
  },
];

---

<section class="kib" style="background-color: #0B1528; padding: 4rem 1rem;">
  <div style="max-width: 60rem; margin: 0 auto;">

    <div style="text-align: center;">
      <span style="display: inline-block; border-radius: 9999px; border: 1px solid #F5A623; background-color: rgba(245,166,35,0.12); color: #F5A623; padding: 0.25rem 1rem; font-size: 0.875rem; font-weight: 600; margin-bottom: 1.5rem;">
        Lebender Beweis
      </span>

      <h2 style="font-size: 2rem; font-weight: 800; color: #FFFFFF; line-height: 1.25; margin: 0 auto 1rem; max-width: 48rem;">
        Ich rede nicht über ein KI-System. Ich führe mein eigenes Geschäft damit.
      </h2>

      <p style="font-size: 1.0625rem; color: #D1D5DB; max-width: 44rem; margin: 0 auto; line-height: 1.65;">
        Ich bin Soloselbstständig, kein Dev-Team, kein Berufs-Programmierer — und trotzdem läuft
        mein komplettes Geschäft auf selbstgebauten KI-Werkzeugen. Jeden Schritt davon
        habe ich verstanden, jeden Schritt besitze ich. Das ist der Unterschied zwischen
        jemandem, der KI verkauft, und einem Operator, der sie täglich selbst betreibt.
        Genau diese Werkzeuge baust du dir — von mir angeleitet — nicht bei deinen Kunden,
        sondern auf deiner Seite des Tisches. Was am Ende läuft, läuft bei dir. Nicht in meiner Black Box.
      </p>
    </div>

    <!-- 6 Domänen-Kacheln (2×3), fest im statischen HTML -->
    <div class="kib-grid" style="margin-top: 2.5rem;">
      {
        domains.map((d) => (
          <article class="kib-tile">
            <p class="kib-tile-benefit">{d.benefit}</p>
            <h3 class="kib-tile-title">{d.title}</h3>
            <ul class="kib-tile-list">
              {d.examples.map((e) => (
                <li>{e}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>

    <!-- Teaser (ehrliche Bestandszahl, kein Performance-Wert) -->
    <p style="text-align: center; color: #9CA3AF; font-size: 0.9375rem; margin: 1.75rem auto 0;">
      Über zwanzig KI-Werkzeuge in sechs Bereichen — die mein Geschäft im Alltag tragen.
    </p>

    <!-- WP-03 — Marcus-Stimme klar als EIGENBELEG, nicht als Fremd-/Kundenzitat -->
    <figure style="margin: 2.75rem auto 0; max-width: 44rem; border-radius: 1rem; border: 1px solid rgba(245,166,35,0.4); background-color: rgba(245,166,35,0.07); padding: 2rem; text-align: left;">
      <p style="margin: 0 0 1rem; font-size: 0.8125rem; font-weight: 700; color: #F5A623; text-transform: uppercase; letter-spacing: 0.08em;">
        Warum ich weiß, dass es trägt: ich lebe es
      </p>
      <blockquote style="margin: 0; font-size: 1.0625rem; color: #D1D5DB; line-height: 1.7; font-style: italic;">
        „Früher hat mich mein Content einen halben Arbeitstag pro Woche gekostet. Heute
        lese ich morgens den Vorschlag meines Systems, schärfe ein paar Sätze und gebe
        frei — der Rest läuft, während ich an dem arbeite, das wirklich zählt. Nicht weil
        ich schneller tippe, sondern weil ich eine Maschine gebaut habe, die mitdenkt."
      </blockquote>
      <figcaption style="display: flex; align-items: center; gap: 1rem; margin-top: 1.25rem;">
        <img src="/marcus.jpg" alt="" width="48" height="48" style="width: 48px; height: 48px; border-radius: 9999px; object-fit: cover; border: 2px solid #F5A623; flex-shrink: 0;" />
        <span>
          <span style="display: block; font-weight: 700; color: #FFFFFF;">Marcus Eichler</span>
          <span style="display: block; font-size: 0.875rem; color: #9CA3AF;">Value Lift AI · KI-Architekt — mein eigener Alltag, kein Kundenzitat</span>
        </span>
      </figcaption>
    </figure>

    <!-- WP-03 — First-Mover offensiv rahmen + Slot für echte (auch anonymisierte) IM-Kundenstimmen.
         [ENTSCHEIDUNG MARCUS]: echte Referenz ist ein Geschäfts-To-do — NICHT erfinden.
         Sobald 1–2 echte IM-Stimmen vorliegen, hier als <figure> einsetzen (Format wie oben,
         aber mit echtem Namen/Kürzel + Kennzeichnung „anonymisiert" falls gewünscht). -->
    <p style="text-align: center; color: #D1D5DB; font-size: 1rem; line-height: 1.6; margin: 2rem auto 0; max-width: 40rem;">
      Noch kein Kundenlogo — weil du zu den <span style="color: #F5A623; font-weight: 700;">Ersten</span> gehörst.
      Ich zeige dir lieber ehrlich mein eigenes laufendes System als ausgedachte Testimonials.
    </p>

  </div>
</section>

<style>
  /* Kachel-Raster: mobil 1-spaltig, ab sm 2-spaltig, ab md 3-spaltig (2×3) */
  .kib-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    text-align: left;
  }
  @media (min-width: 640px) {
    .kib-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 768px) {
    .kib-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .kib-tile {
    border-radius: 1rem;
    border: 1px solid rgba(245, 166, 35, 0.3);
    background-color: rgba(245, 166, 35, 0.06);
    padding: 1.5rem;
  }

  /* Vorteil-Zeile: Kundennutzen zuerst, orange hervorgehoben (Orange auf Navy ≈ 8:1 → WCAG AA) */
  .kib-tile-benefit {
    font-size: 0.9375rem;
    font-weight: 700;
    color: #f5a623;
    line-height: 1.5;
    margin: 0 0 0.75rem;
  }

  .kib-tile-title {
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 0.5rem;
    font-size: 1.125rem;
  }

  /* Beispiele: kompakt und dezenter als die Überschrift */
  .kib-tile-list {
    margin: 0;
    padding-left: 1.1rem;
    font-size: 0.875rem;
    color: #9ca3af;
    line-height: 1.55;
  }
  .kib-tile-list li {
    margin: 0.2rem 0;
  }
  .kib-tile-list li::marker {
    color: rgba(245, 166, 35, 0.6);
  }
</style>
