---
// Hero mit Aufgaben-Rotator (hero-rotator, 2026-07-03).
// H1 trägt den vollständigen Satz als semantischen Grundtext (SEO/Screenreader/No-JS);
// JS blendet ihn nur visuell aus und rotiert stattdessen die 6 Tätigkeiten im
// orangen Slot. Reduced Motion → JS bricht ab, der volle Satz bleibt stehen.
// Slot-Höhe per CSS-Grid-Stapel (alle Items übereinander, unsichtbar) → kein CLS.

// Sichtbare Rotator-Items enden mit "?" — der crawlbare H1-Volltext (vollerSatz)
// bleibt bewusst EIN Aussagesatz ohne Fragezeichen.
const taetigkeiten = [
  "schreibt deine Statusberichte?",
  "findet die Engpässe in deinen Prozessen?",
  "mappt deine Stakeholder, bevor du sie brauchst?",
  "gewinnt neue Auftraggeber?",
  "hält den Kontakt zu deinen Bestandskunden?",
  "erledigt deine Korrespondenz und Social-Media-Beiträge?",
];

const vollerSatz =
  "Dein KI-System schreibt deine Statusberichte, findet die Engpässe in deinen Prozessen, " +
  "mappt deine Stakeholder, gewinnt neue Auftraggeber, hält den Kontakt zu deinen " +
  "Bestandskunden und erledigt deine Korrespondenz und Social-Media-Beiträge.";
---

<section class="relative overflow-hidden bg-brand-dark text-brand-white" style="min-height: 540px;">

  <!-- Vollbild-Hintergrund: dein Foto -->
  <div style="position: absolute; inset: 0;">
    <img src="/hero-bg.webp" alt="" aria-hidden="true"
      width="1536" height="1024" fetchpriority="high"
      style="width: 100%; height: 100%; object-fit: cover; object-position: center top;" />
    <!-- Gradient: links stark abgedunkelt für Lesbarkeit, rechts Foto kräftig sichtbar -->
    <div style="position: absolute; inset: 0;
      background: linear-gradient(to right, rgba(11,21,40,0.97) 0%, rgba(11,21,40,0.85) 35%, rgba(11,21,40,0.3) 62%, rgba(11,21,40,0) 100%);"></div>
  </div>

  <!-- Text: linksbündig, max. halbe Breite -->
  <div style="position: relative; z-index: 1; max-width: 72rem; margin: 0 auto; padding: 5rem 1.5rem 4rem;">
    <div style="max-width: 36rem;">

      <!-- Badge: für wen -->
      <span style="display: inline-block; border: 1px solid rgba(245,166,35,0.5); background: rgba(245,166,35,0.08); color: #F5A623; font-size: 0.8125rem; font-weight: 600; padding: 0.3rem 0.875rem; border-radius: 9999px; margin-bottom: 1.25rem;">
        Für Interim Manager
      </span>

      <!-- H1: voller Satz als semantischer Grundtext; Rotator wird per JS aktiviert -->
      <h1 id="hero-h1" style="font-size: clamp(1.875rem, 4vw, 2.875rem); font-weight: 800; line-height: 1.15; color: #FFFFFF; margin-bottom: 1rem;">
        <span id="hero-h1-full">{vollerSatz}</span>
        <span id="hero-h1-rotator" hidden aria-hidden="true">
          <span style="display: block;">Dein KI-System</span>
          <span id="hero-slot" style="display: grid; color: #F5A623;">
            {taetigkeiten.map((t, i) => (
              <span class={"hero-slot-item" + (i === 0 ? " is-active" : "")} style="grid-area: 1 / 1;">{t}</span>
            ))}
          </span>
        </span>
      </h1>

      <!-- Brücke + Primär-CTA → /buchen: auf Desktop nebeneinander (Button rechts,
           vertikal zentriert), auf Mobil stapelnd via flex-wrap -->
      <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.25rem; margin-top: 0.75rem; margin-bottom: 1.25rem;">
        <p style="font-size: 1.375rem; font-weight: 700; color: #FFFFFF; margin: 0;">
          Deins noch nicht?
        </p>
        <a
          href="/buchen/"
          style="display: inline-block; background: #F5A623; color: #0B1528; font-weight: 700; font-size: 1.0625rem; padding: 0.95rem 2.1rem; border-radius: 0.5rem; text-decoration: none;"
        >
          Dann lass uns sprechen.
        </a>
      </div>

      <!-- Statische Subline: sagt in einem Satz, worum es geht — nicht Teil der Rotation, immer sichtbar -->
      <p style="font-size: 1.125rem; color: #D1D5DB; line-height: 1.6; margin: 0 0 1.75rem; max-width: 34rem;">
        Du lernst, wie du dein eigenes KI-System erstellst, und danach gehört es dir.
      </p>

      <!-- Beleg: Credibility-Zeile (Trust-Element) -->
      <div style="display: flex; flex-wrap: wrap; gap: 0.35rem 0.6rem;">
        <span style="font-size: 0.8125rem; font-weight: 600; color: #F5A623;">Marcus Eichler</span>
        <span style="color: #4B5563; font-size: 0.8125rem;">·</span>
        <span style="font-size: 0.8125rem; color: #9CA3AF;">Dipl.-Wirtschaftsingenieur</span>
        <span style="color: #4B5563; font-size: 0.8125rem;">·</span>
        <span style="font-size: 0.8125rem; color: #9CA3AF;">CEO-Exit</span>
        <span style="color: #4B5563; font-size: 0.8125rem;">·</span>
        <span style="font-size: 0.8125rem; color: #9CA3AF;">Lean Six Sigma Master Black Belt</span>
        <span style="color: #4B5563; font-size: 0.8125rem;">·</span>
        <span style="font-size: 0.8125rem; color: #9CA3AF;">&gt;1 Mrd. € Impact · Telefónica</span>
        <span style="color: #4B5563; font-size: 0.8125rem;">·</span>
        <span style="font-size: 0.8125rem; color: #9CA3AF;">KI seit 2004</span>
      </div>

    </div>
  </div>
</section>

<style>
  /* Rotator-Items: alle im selben Grid-Feld gestapelt → Slot ist so hoch wie das
     höchste Item (auch umgebrochen), Rotation verursacht kein Layout-Springen. */
  .hero-slot-item {
    opacity: 0;
    transform: translateY(0.35em);
    transition: opacity 0.4s ease, transform 0.4s ease;
    pointer-events: none;
  }
  .hero-slot-item.is-active {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-slot-item {
      transition: none;
    }
  }
</style>

<script is:inline>
  (function () {
    // Reduced Motion: nichts umschalten, der volle H1-Satz bleibt statisch stehen.
    if (window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    var full = document.getElementById("hero-h1-full");
    var rotator = document.getElementById("hero-h1-rotator");
    if (!full || !rotator) return;

    // Vollen Satz nur VISUELL verstecken (Screenreader lesen ihn weiter als H1-Text);
    // der Rotator ist aria-hidden, damit kein Wechsel vorgelesen wird.
    full.style.position = "absolute";
    full.style.width = "1px";
    full.style.height = "1px";
    full.style.overflow = "hidden";
    full.style.clip = "rect(0 0 0 0)";
    full.style.whiteSpace = "nowrap";
    rotator.hidden = false;

    var items = rotator.querySelectorAll(".hero-slot-item");
    var idx = 0;
    setInterval(function () {
      items[idx].classList.remove("is-active");
      idx = (idx + 1) % items.length;
      items[idx].classList.add("is-active");
    }, 2000);
  })();
</script>
