---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import OfferCards from "../components/OfferCards.astro";
import KiBeweis from "../components/KiBeweis.astro";
import { GARANTIE_KERN } from "../lib/garantie";

// IM-Pivot (Modell B): Startseite für solo Operations-/COO-Interim-Manager.
// Leitplanken: kein oeffentlicher Preis, kein Stripe, kein Coaching-Jargon; ein Hero-Versprechen; alle CTAs → /buchen.
// Segmentierung nach Auftragsphase, nie nach Preis. Garantie = Umsetzungs-Garantie (🔴 Wortlaut UM-10).

// FAQ lebt vollständig auf /faq (inkl. FAQPage-JSON-LD) — keine Startseiten-FAQ mehr.
---

<Base
  title="KI-Systeme für solo Interim-Manager | Value Lift AI"
  description="Dein KI-System als Operations-/COO-Interim-Manager im DACH-Raum: sichtbar liefern und die Pipeline warmhalten, während du beim Kunden bist."
  path="/"
>

  <!-- 1. Hero (UM-03) -->
  <Hero />

  <!-- 2. Hürden: woran Interim-Manager mit KI scheitern (ersetzt Akquise-Paradox) -->
  <section style="background-color: #FFFFFF; padding: 4rem 1rem;">
    <div style="max-width: 72rem; margin: 0 auto;">
      <p style="font-size: 0.8125rem; font-weight: 700; color: #F5A623; text-transform: uppercase; letter-spacing: 0.08em; margin: 0 0 0.75rem;">
        Das hält dich auf
      </p>
      <div style="display: flex; flex-wrap: wrap; gap: 2rem; align-items: flex-start; margin-bottom: 2.75rem;">
        <h2 style="flex: 1; min-width: 300px; font-size: clamp(1.75rem, 3.5vw, 2.5rem); font-weight: 800; color: #0B1528; line-height: 1.15; margin: 0;">
          Woran <span style="color: #F5A623;">„KI nebenbei"</span> regelmäßig scheitert
        </h2>
        <p style="flex: 1; min-width: 280px; font-size: 1rem; color: #6B7280; line-height: 1.7; margin: 0;">
          Du probierst ChatGPT zwischen zwei Terminen. Mal klappt's, meist nicht — und für ein sauberes System fehlt im laufenden Auftrag die Zeit. So bleibt KI eine Nebensache statt ein Hebel, der deinen Tagessatz rechtfertigt.
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem;">
        <article style="background: #FFFFFF; border: 1px solid #E5E7EB; border-radius: 1rem; padding: 1.75rem;">
          <div style="width: 48px; height: 48px; border-radius: 0.6rem; background: #F5A623; display: flex; align-items: center; justify-content: center; font-size: 1.4rem; margin-bottom: 1.25rem;">🧩</div>
          <h3 style="font-size: 1.125rem; font-weight: 800; color: #0B1528; line-height: 1.25; margin: 0 0 0.6rem;">Viele Tools, kein Fahrplan</h3>
          <p style="font-size: 0.9375rem; color: #6B7280; line-height: 1.6; margin: 0;">Du springst zwischen ChatGPT und zig Werkzeugen, aber nichts spielt zusammen. Ohne roten Faden, welcher Prozess zuerst kommt und wie alles ineinandergreift, bleibt es Stückwerk statt System.</p>
        </article>
        <article style="background: #FFFFFF; border: 1px solid #E5E7EB; border-radius: 1rem; padding: 1.75rem;">
          <div style="width: 48px; height: 48px; border-radius: 0.6rem; background: #F5A623; display: flex; align-items: center; justify-content: center; font-size: 1.4rem; margin-bottom: 1.25rem;">⏳</div>
          <h3 style="font-size: 1.125rem; font-weight: 800; color: #0B1528; line-height: 1.25; margin: 0 0 0.6rem;">Nebenbei wird es nie fertig</h3>
          <p style="font-size: 0.9375rem; color: #6B7280; line-height: 1.6; margin: 0;">Die abrechenbare Arbeit geht immer vor. Der Aufbau deines KI-Systems rutscht ans Ende der Liste und bleibt liegen, Monat für Monat.</p>
        </article>
        <article style="background: #FFFFFF; border: 1px solid #E5E7EB; border-radius: 1rem; padding: 1.75rem;">
          <div style="width: 48px; height: 48px; border-radius: 0.6rem; background: #F5A623; display: flex; align-items: center; justify-content: center; font-size: 1.4rem; margin-bottom: 1.25rem;">🧰</div>
          <h3 style="font-size: 1.125rem; font-weight: 800; color: #0B1528; line-height: 1.25; margin: 0 0 0.6rem;">Know-how fehlt, und niemand baut mit</h3>
          <p style="font-size: 0.9375rem; color: #6B7280; line-height: 1.6; margin: 0;">Über einzelne Prompts kommst du allein nicht hinaus, und das technische Fundament fehlt. Kurse hast du vielleicht schon, aber die Umsetzung bleibt an dir hängen.</p>
        </article>
        <article style="background: #FFFFFF; border: 1px solid #E5E7EB; border-radius: 1rem; padding: 1.75rem;">
          <div style="width: 48px; height: 48px; border-radius: 0.6rem; background: #F5A623; display: flex; align-items: center; justify-content: center; font-size: 1.4rem; margin-bottom: 1.25rem;">🔁</div>
          <h3 style="font-size: 1.125rem; font-weight: 800; color: #0B1528; line-height: 1.25; margin: 0 0 0.6rem;">Jede Aufgabe beginnt von vorn</h3>
          <p style="font-size: 0.9375rem; color: #6B7280; line-height: 1.6; margin: 0;">Ohne feste Struktur erklärst du der KI jedes Mal neu, was du brauchst. Nichts baut aufeinander auf, es entstehen verstreute Prompts statt ein System, das bleibt.</p>
        </article>
      </div>
    </div>
  </section>

  <!-- 2b. Einzelaktion → System (jopenau-Thema) -->
  <section style="background-color: #F9F7F7; padding: 4rem 1rem;">
    <div style="max-width: 48rem; margin: 0 auto;">
      <h2 style="font-size: clamp(1.625rem, 3vw, 2.125rem); font-weight: 800; color: #0B1528; line-height: 1.2; margin: 0 0 1.75rem; text-align: center;">
        Du nutzt KI schon. Aber als Einzelaktion — nicht als Mitarbeiter, die schon wissen, wie dein Geschäft funktioniert.
      </h2>
      <ul style="list-style: none; padding: 0; margin: 0 0 1.75rem; display: flex; flex-direction: column; gap: 1rem;">
        <li style="font-size: 1.0625rem; color: #374151; line-height: 1.7; padding-left: 1.1rem; border-left: 3px solid #F5A623;">
          Jedes Mal erklärst du ChatGPT wieder von neuem, was du brauchst.
        </li>
        <li style="font-size: 1.0625rem; color: #374151; line-height: 1.7; padding-left: 1.1rem; border-left: 3px solid #F5A623;">
          Das Ergebnis ist okay, aber es kostet dich Zeit, deine KI jedes Mal neu zu informieren.
        </li>
        <li style="font-size: 1.0625rem; color: #374151; line-height: 1.7; padding-left: 1.1rem; border-left: 3px solid #F5A623;">
          Kontext, Tonalität, dein Vorgehen: nach 200 Nachrichten „vergessen". Deine Eingaben sind weg.
        </li>
        <li style="font-size: 1.0625rem; color: #374151; line-height: 1.7; padding-left: 1.1rem; border-left: 3px solid #F5A623;">
          Diese Reibung kostet genau die Zeit, die im Auftrag zählt — während die eigentliche Arbeit liegen bleibt.
        </li>
      </ul>
      <p style="font-size: 1.0625rem; color: #0B1528; margin: 0; line-height: 1.75; font-weight: 600; text-align: center;">
        Was fehlt, ist kein weiteres Tool, sondern <span style="color: #F5A623;">ein System, das dein Geschäft kennt</span> und jedes Mal wieder liefert.
      </p>
    </div>
  </section>

  <!-- 3. Über Marcus — Operator-Herkunft als Vertrauensanker (UM-06) -->
  <section style="background-color: #F9F7F7; padding: 4rem 1rem;">
    <div style="max-width: 56rem; margin: 0 auto;">
      <div style="display: flex; flex-wrap: wrap; gap: 2.5rem; align-items: center;">

        <img
          src="/marcus.jpg"
          alt="Marcus Eichler — KI-Architekt und Ex-Operator"
          width="120"
          height="120"
          loading="lazy"
          style="width: 120px; height: 120px; border-radius: 9999px; object-fit: cover; border: 3px solid #F5A623; flex-shrink: 0;"
        />

        <div style="flex: 1; min-width: 260px;">
          <p style="font-size: 0.875rem; font-weight: 700; color: #F5A623; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.25rem;">
            Ich bin Marcus
          </p>
          <h2 style="font-size: 1.5rem; font-weight: 800; color: #0B1528; margin-bottom: 0.75rem;">
            KI-Architekt — und selbst Operator.
          </h2>
          <p style="font-size: 1rem; color: #374151; line-height: 1.7; margin-bottom: 1rem;">
            Ich bin keine Agentur, die dich von einer Black Box abhängig macht. Ich bin
            <strong style="color: #0B1528;">KI-Architekt und selbst Operator</strong>: 29 Jahre
            Führung, ein CEO-Exit, über 1 Mrd. Euro Impact bei Telefónica. Ich kenne den Druck
            im Geschäft aus eigener Erfahrung. Deshalb befähige ich dich, dir die KI-Werkzeuge,
            die genau dort liefern, selbst zu bauen. Du verstehst jeden Schritt und führst das
            System nach unserer Zusammenarbeit ohne mich weiter.
          </p>
          <div style="display: flex; flex-wrap: wrap; gap: 0.4rem;">
            <span style="background-color: rgba(11,21,40,0.07); color: #374151; padding: 0.15rem 0.6rem; border-radius: 9999px; font-size: 0.8125rem;">Elektriker</span>
            <span style="background-color: rgba(11,21,40,0.07); color: #374151; padding: 0.15rem 0.6rem; border-radius: 9999px; font-size: 0.8125rem;">29 Jahre Führungserfahrung</span>
            <span style="background-color: rgba(11,21,40,0.07); color: #374151; padding: 0.15rem 0.6rem; border-radius: 9999px; font-size: 0.8125rem;">Lean Six Sigma Master Black Belt</span>
            <span style="background-color: rgba(11,21,40,0.07); color: #374151; padding: 0.15rem 0.6rem; border-radius: 9999px; font-size: 0.8125rem;">Certified Trainer</span>
            <span style="background-color: rgba(11,21,40,0.07); color: #374151; padding: 0.15rem 0.6rem; border-radius: 9999px; font-size: 0.8125rem;">CEO-Exit MyDisplays</span>
            <span style="background-color: rgba(11,21,40,0.07); color: #374151; padding: 0.15rem 0.6rem; border-radius: 9999px; font-size: 0.8125rem;">&gt;1 Mrd. Euro · Telefónica</span>
          </div>
          <a
            href="/ueber-mich/"
            style="display: inline-block; margin-top: 1rem; font-size: 0.9375rem; font-weight: 600; color: #F5A623; text-decoration: none;"
          >
            Mehr über Marcus →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. So läuft die Zusammenarbeit — 3 Schritte (IM, kein Preis) -->
  <section style="background-color: #FFFFFF; padding: 4rem 1rem;">
    <div style="max-width: 56rem; margin: 0 auto; text-align: center;">
      <h2 style="font-size: 1.875rem; font-weight: 800; color: #0B1528; margin-bottom: 2.5rem;">
        So läuft die Zusammenarbeit
      </h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 2rem; text-align: left;">

        <div style="position: relative; padding-left: 1rem;">
          <div style="width: 2.5rem; height: 2.5rem; background-color: #F5A623; border-radius: 9999px; display: flex; align-items: center; justify-content: center; font-weight: 800; color: #000; margin-bottom: 1rem;">1</div>
          <h3 style="font-weight: 700; color: #0B1528; margin-bottom: 0.5rem;">Erstgespräch</h3>
          <p style="font-size: 0.9375rem; color: #6B7280; line-height: 1.5;">
            20 Minuten, kostenlos. Wir klären, wo du stehst, was du brauchst und welche KI-Anwendung dir heute den größten Hebel bringt. Und wir schauen gemeinsam, wie du den Aufbau realistisch in deine Woche einplanst.
          </p>
        </div>

        <div style="position: relative; padding-left: 1rem;">
          <div style="width: 2.5rem; height: 2.5rem; background-color: #F5A623; border-radius: 9999px; display: flex; align-items: center; justify-content: center; font-weight: 800; color: #000; margin-bottom: 1rem;">2</div>
          <h3 style="font-weight: 700; color: #0B1528; margin-bottom: 0.5rem;">Dein System, auf dich eingestellt</h3>
          <p style="font-size: 0.9375rem; color: #6B7280; line-height: 1.5;">
            In Tagen statt Monaten baust du dir dein KI-System selbst auf, angeleitet Schritt für Schritt. Es läuft auf deiner eigenen Seite, nie im Kundensystem, und liefert genau die Ergebnisse, die dir im Alltag helfen. Endlich ein System, das zu deiner Arbeitsweise passt statt umgekehrt.
          </p>
        </div>

        <div style="position: relative; padding-left: 1rem;">
          <div style="width: 2.5rem; height: 2.5rem; background-color: #F5A623; border-radius: 9999px; display: flex; align-items: center; justify-content: center; font-weight: 800; color: #000; margin-bottom: 1rem;">3</div>
          <h3 style="font-weight: 700; color: #0B1528; margin-bottom: 0.5rem;">Danach führst du es allein</h3>
          <p style="font-size: 0.9375rem; color: #6B7280; line-height: 1.5;">
            Nach dem Kurs entwickelst du dein System weiter, skalierst es oder lässt es einfach ruhig laufen. Du besitzt es, du verstehst es, und du brauchst mich dafür nicht mehr.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- 5. Angebots-Struktur (AN-01/02) — drei Karten; „Wo stehst du?" ist in die
       Sektions-Intro von OfferCards integriert (frühere separate Router-Sektion entfällt). -->
  <OfferCards />

  <!-- 5a. Aufbau des KI-Sprint — 4 Boxen (Wochenziele, Selberbauen, Live-Call, Takt/Pause);
       Detailtiefe auf /ki-sprint (Programminhalte). Klartext, keine Insider-Begriffe. -->
  <section style="background-color: #0B1528; padding: 4rem 1rem;">
    <div style="max-width: 56rem; margin: 0 auto;">
      <div style="text-align: center;">
        <p style="font-size: 0.8125rem; font-weight: 700; color: #F5A623; text-transform: uppercase; letter-spacing: 0.08em; margin: 0 0 0.75rem;">
          Aufbau des KI-Sprint
        </p>
        <h2 style="font-size: 2rem; font-weight: 800; color: #FFFFFF; line-height: 1.25; margin: 0 auto 2.5rem; max-width: 48rem;">
          In 8 Wochen baust du dir ein KI-System,
          <span style="color: #F5A623;">das dich täglich unterstützt und deine Pipeline warmhält.</span>
        </h2>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 1.25rem; text-align: left;">
        <article style="background: #FFFFFF; border-radius: 1rem; border-bottom: 4px solid #F5A623; padding: 1.75rem;">
          <h3 style="font-size: 1.0625rem; font-weight: 700; color: #0B1528; margin: 0 0 0.5rem;">
            Jede Woche ein fertiger Baustein
          </h3>
          <p style="font-size: 0.9375rem; color: #374151; line-height: 1.6; margin: 0;">
            Getaktete Wochenziele, kein Dauer-Kurs ohne Ende. Am Ende jeder Woche liegt ein lauffähiger Baustein vor, keine Notizen und keine guten Vorsätze. Nach acht Wochen steht dein System.
          </p>
        </article>
        <article style="background: #FFFFFF; border-radius: 1rem; border-bottom: 4px solid #F5A623; padding: 1.75rem;">
          <h3 style="font-size: 1.0625rem; font-weight: 700; color: #0B1528; margin: 0 0 0.5rem;">
            Du baust es selbst, angeleitet
          </h3>
          <p style="font-size: 0.9375rem; color: #374151; line-height: 1.6; margin: 0;">
            Wir schulen dich, statt es für dich zu bauen. Du machst jeden Schritt selbst und verstehst, warum er so aussieht. Deshalb kannst du das System später selbst anpassen und erweitern. Es gehört dir, nicht einer Agentur.
          </p>
        </article>
        <article style="background: #FFFFFF; border-radius: 1rem; border-bottom: 4px solid #F5A623; padding: 1.75rem;">
          <h3 style="font-size: 1.0625rem; font-weight: 700; color: #0B1528; margin: 0 0 0.5rem;">
            Wöchentlicher Live-Call mit mir und anderen Teilnehmern
          </h3>
          <p style="font-size: 0.9375rem; color: #374151; line-height: 1.6; margin: 0;">
            Einmal pro Woche triffst du mich und die anderen Teilnehmer live in der Gruppe. Fragen klären, Feedback holen, sehen wie andere es lösen. Verpasst du einen Termin, bekommst du die Aufzeichnung.
          </p>
        </article>
        <article style="background: #FFFFFF; border-radius: 1rem; border-bottom: 4px solid #F5A623; padding: 1.75rem;">
          <h3 style="font-size: 1.0625rem; font-weight: 700; color: #0B1528; margin: 0 0 0.5rem;">
            In deinem Takt, Pause jederzeit
          </h3>
          <p style="font-size: 0.9375rem; color: #374151; line-height: 1.6; margin: 0;">
            Wir bleiben dran, bis dein erster KI-Prozess läuft, Bedingung ist, dass du mitziehst. Kommt dir etwas dazwischen, pausierst du und steigst danach wieder ein. Accountability ohne Gängelei: Trainer, kein Fitnessstudio.
          </p>
        </article>
      </div>

      <p style="text-align: center; margin: 2rem 0 0;">
        <a href="/ki-sprint/" style="color: #F5A623; font-weight: 700; font-size: 1rem; text-decoration: none;">
          Alle Programminhalte ansehen →
        </a>
      </p>
    </div>
  </section>

  <!-- 5b. App-Warteliste (derzeit in Entwicklung) — Inline-DOI-Signup analog /check,
       leadmagnet:'app-warteliste' → angelwrite-server /leadmagnet/signup -->
  <section id="app-warteliste" style="background-color: #F9F7F7; padding: 4rem 1rem;">
    <div style="max-width: 56rem; margin: 0 auto;">
      <div style="display: flex; flex-wrap: wrap; gap: 2.5rem; align-items: center;">
        <div style="flex: 1; min-width: 260px;">
          <p style="font-size: 0.8125rem; font-weight: 700; color: #F5A623; text-transform: uppercase; letter-spacing: 0.08em; margin: 0 0 0.5rem;">
            Derzeit in Entwicklung
          </p>
          <h2 style="font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 800; color: #0B1528; line-height: 1.2; margin: 0 0 1rem;">
            Aus 20+ selbstgebauten Werkzeugen wird ein Gesamtangebot. Die ersten Tester wählen wir gerade aus.
          </h2>
          <p style="font-size: 1rem; color: #374151; line-height: 1.7; margin: 0 0 1rem;">
            Über die Jahre sind mehr als 20 eigene KI-Werkzeuge entstanden, mit denen ich mein
            eigenes Geschäft betreibe. Nicht als Demo, sondern im täglichen Einsatz. Gerade
            stelle ich die wirksamsten dieser Helferlein zu einem zusammenhängenden Angebot
            zusammen, das deine Sichtbarkeits- und Pipeline-Maschine dauerhaft am Laufen hält.
          </p>
          <p style="font-size: 1rem; color: #374151; line-height: 1.7; margin: 0 0 1rem;">
            Bevor das offen verfügbar ist, öffne ich es für einen kleinen Kreis früher Tester.
            Wer hier dabei ist, arbeitet mit den fertigen Bausteinen als Erster, bekommt
            kürzere Wege zu mir und beeinflusst mit, welche Werkzeuge zuerst ausgebaut werden.
          </p>
          <p style="font-size: 1rem; color: #374151; line-height: 1.7; margin: 0 0 1.5rem;">
            Auf der Warteliste stehen heißt nur eins: Du bist informiert, sobald die erste
            Testrunde startet, und rückst in der Reihenfolge nach vorne. Keine Verpflichtung,
            keine automatische Buchung.
          </p>

          <form id="wl-form" style="display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 0 0 0.75rem;" novalidate>
            <label for="wl-email" class="sr-only" style="position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0);">E-Mail-Adresse</label>
            <input
              type="email"
              id="wl-email"
              name="email"
              required
              autocomplete="email"
              placeholder="deine@email.de"
              style="flex: 1; min-width: 220px; padding: 0.85rem 1rem; font-size: 1rem; color: #0B1528; background: #FFFFFF; border: 1px solid #D1D5DB; border-radius: 0.5rem;"
            />
            <button
              type="submit"
              id="wl-btn"
              style="display: inline-block; background: #F5A623; color: #0B1528; font-weight: 700; font-size: 1rem; padding: 0.85rem 1.9rem; border-radius: 0.5rem; border: none; cursor: pointer;"
            >
              Auf die Warteliste
            </button>
          </form>
          <p id="wl-success" hidden style="font-size: 1rem; font-weight: 600; color: #15803D; margin: 0 0 0.75rem;"></p>
          <p id="wl-error" hidden style="font-size: 0.9375rem; color: #B91C1C; margin: 0 0 0.75rem;"></p>

          <p style="font-size: 0.875rem; color: #6B7280; line-height: 1.6; margin: 0;">
            Unverbindlich. Du hörst von uns, sobald die erste Testrunde öffnet, nicht früher
            und nicht mit Werbung dazwischen.
          </p>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var SIGNUP_URL = "https://angelwrite-server-production.up.railway.app/leadmagnet/signup";
      var form = document.getElementById("wl-form");
      var input = document.getElementById("wl-email");
      var btn = document.getElementById("wl-btn");
      var ok = document.getElementById("wl-success");
      var err = document.getElementById("wl-error");
      if (!form) return;

      function showSuccess(msg) {
        form.hidden = true;
        err.hidden = true;
        ok.textContent = msg;
        ok.hidden = false;
      }
      function showError(msg) {
        err.textContent = msg;
        err.hidden = false;
      }

      // Rückkehr aus der DOI-Mail: /?warteliste=ok#app-warteliste
      if (new URLSearchParams(location.search).get("warteliste") === "ok") {
        showSuccess("Bestätigt. Du stehst auf der Liste und hörst von uns, sobald die erste Testrunde startet.");
      }

      form.addEventListener("submit", function (e) {
        e.preventDefault();
        err.hidden = true;
        var email = (input.value || "").trim();
        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          showError("Bitte gib eine gültige E-Mail-Adresse ein.");
          return;
        }
        btn.disabled = true;
        var label = btn.textContent;
        btn.textContent = "Wird gesendet …";
        fetch(SIGNUP_URL, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email: email, leadmagnet: "app-warteliste" }),
        })
          .then(function (r) {
            return r.json().catch(function () { return {}; }).then(function (d) {
              return { ok: r.ok && d.ok, d: d };
            });
          })
          .then(function (res) {
            if (res.ok) {
              if (res.d && res.d.status === "already_confirmed") {
                showSuccess("Du stehst auf der Liste und hörst von uns, sobald die erste Testrunde startet.");
              } else {
                showSuccess("Fast geschafft. Bestätige kurz deine E-Mail, dann bist du auf der Liste.");
              }
            } else {
              showError((res.d && res.d.error) || "Konnte gerade nicht senden. Bitte versuche es erneut.");
              btn.disabled = false;
              btn.textContent = label;
            }
          })
          .catch(function () {
            showError("Verbindung fehlgeschlagen. Bitte versuche es erneut.");
            btn.disabled = false;
            btn.textContent = label;
          });
      });
    })();
  </script>

